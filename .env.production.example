# Production environment template (do not commit real secrets)

LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=replace_with_real_secret
OPENAI_API_KEY=
HF_TOKEN=

DEVICE=auto
MAX_NEW_TOKENS=256
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.5
STARTUP_PROVIDER_CONNECTIVITY_CHECK=true
STARTUP_PROVIDER_CHECK_FAIL_FAST=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=healthbuddy_docs
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_RETRIEVAL_RESULTS=5

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
ENVIRONMENT=production
SECRET_KEY=replace_with_long_random_secret_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAMES=admin

# Use a managed PostgreSQL database in production
DATABASE_URL=postgresql+psycopg://healthbuddy:change_me@db.example.com:5432/healthbuddy

# Use real frontend domains only (no localhost)
CORS_ORIGINS=https://app.example.com,https://www.example.com

MAX_REQUEST_SIZE_MB=10
UPLOAD_MAX_SIZE_MB=8
STRICT_UPLOAD_MIME_CHECK=true
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,text/plain,text/markdown
RATE_LIMIT_REQUESTS_PER_MINUTE=90
RATE_LIMIT_ROUTE_OVERRIDES=/api/v1/auth/login=10,/api/v1/chat=60
STATIC_ASSET_CACHE_SECONDS=31536000
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_MIN_PASSWORD_LENGTH=10
DEFAULT_INPUT_TOKENS_PER_CHAR=0.25
DEFAULT_OUTPUT_TOKENS_PER_CHAR=0.25
COST_RATE_INPUT_PER_1K_TOKENS_USD=0.0005
COST_RATE_OUTPUT_PER_1K_TOKENS_USD=0.0015
RESPONSE_CACHE_TTL_SECONDS=120
RESPONSE_CACHE_MAX_ENTRIES=1000
DATA_RETENTION_DAYS=365

# Shared backend store for lockout state across replicas
REDIS_URL=redis://redis.example.com:6379/0

# Optional startup tuning
PRELOAD_VECTOR_STORE_ON_STARTUP=true
PRELOAD_MODELS_ON_STARTUP=false
DB_AUTO_CREATE_ON_STARTUP=false
DB_RUN_MIGRATIONS_ON_STARTUP=false

CUSTOM_MODEL_PATH=./data/checkpoints/transformer_best.pt
