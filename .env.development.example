# Development environment template (safe defaults)

LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=replace_with_local_secret_or_leave_blank
OPENAI_API_KEY=
HF_TOKEN=

DEVICE=auto
MAX_NEW_TOKENS=256
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.5
STARTUP_PROVIDER_CONNECTIVITY_CHECK=false
STARTUP_PROVIDER_CHECK_FAIL_FAST=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=healthbuddy_docs
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_RETRIEVAL_RESULTS=5

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
ENVIRONMENT=development
SECRET_KEY=replace_with_local_dev_secret_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ADMIN_USERNAMES=admin

DATABASE_URL=sqlite:///./data/healthbuddy.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

MAX_REQUEST_SIZE_MB=10
UPLOAD_MAX_SIZE_MB=8
STRICT_UPLOAD_MIME_CHECK=true
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,text/plain,text/markdown
RATE_LIMIT_REQUESTS_PER_MINUTE=90
RATE_LIMIT_ROUTE_OVERRIDES=/api/v1/auth/login=20,/api/v1/chat=80
STATIC_ASSET_CACHE_SECONDS=31536000
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_MIN_PASSWORD_LENGTH=10
DEFAULT_INPUT_TOKENS_PER_CHAR=0.25
DEFAULT_OUTPUT_TOKENS_PER_CHAR=0.25
COST_RATE_INPUT_PER_1K_TOKENS_USD=0.0005
COST_RATE_OUTPUT_PER_1K_TOKENS_USD=0.0015
RESPONSE_CACHE_TTL_SECONDS=180
RESPONSE_CACHE_MAX_ENTRIES=500
DATA_RETENTION_DAYS=365
REDIS_URL=

# DB_AUTO_CREATE_ON_STARTUP=true — fast path for local dev; creates missing tables via
# SQLAlchemy metadata.create_all() on every startup. Leaves existing tables untouched.
# Set to false in any environment where you want Alembic to own the schema.
PRELOAD_VECTOR_STORE_ON_STARTUP=false
PRELOAD_MODELS_ON_STARTUP=false
DB_AUTO_CREATE_ON_STARTUP=true

# DB_RUN_MIGRATIONS_ON_STARTUP=false — set to true to run `alembic upgrade head`
# automatically at startup. The migrations live in alembic/versions/ and are the
# authoritative schema definition. Use this in staging/production instead of
# DB_AUTO_CREATE_ON_STARTUP. Running both is safe (create_all is a no-op on existing tables)
# but migrations are the production-recommended path.
DB_RUN_MIGRATIONS_ON_STARTUP=false

CUSTOM_MODEL_PATH=./data/checkpoints/transformer_best.pt
