# ==========================================
# Healthbuddy-AI Chatbot — Environment Config
# ==========================================

# --- LLM Configuration ---
# Options: "huggingface" | "custom" | "ollama"
LLM_PROVIDER=huggingface
# HuggingFace model name (decoder-only models recommended)
# Small: gpt2, distilgpt2
# Medium: TinyLlama/TinyLlama-1.1B-Chat-v1.0
# Large (needs GPU): meta-llama/Llama-2-7b-chat-hf, tiiuae/falcon-7b-instruct, bigscience/bloom-1b1
LLM_MODEL=gpt2
HF_TOKEN=
# Device: "auto", "cpu", "cuda", "mps"
DEVICE=auto
# Max new tokens for generation
MAX_NEW_TOKENS=256
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.5
STARTUP_PROVIDER_CONNECTIVITY_CHECK=true
STARTUP_PROVIDER_CHECK_FAIL_FAST=false

# --- Embedding Model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- ChromaDB ---
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=healthbuddy_docs

# --- Document Processing ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_RETRIEVAL_RESULTS=5

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
ENVIRONMENT=development
# Comma-separated list, no spaces. Use explicit domains in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_REQUEST_SIZE_MB=10
UPLOAD_MAX_SIZE_MB=10
STRICT_UPLOAD_MIME_CHECK=true
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,text/plain,text/markdown
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_ROUTE_OVERRIDES=/api/v1/auth/login=20,/api/v1/chat=80
STATIC_ASSET_CACHE_SECONDS=31536000
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_MIN_PASSWORD_LENGTH=10
REDIS_URL=
PRELOAD_VECTOR_STORE_ON_STARTUP=false
PRELOAD_MODELS_ON_STARTUP=false
DB_AUTO_CREATE_ON_STARTUP=true
DB_RUN_MIGRATIONS_ON_STARTUP=false
DEFAULT_INPUT_TOKENS_PER_CHAR=0.25
DEFAULT_OUTPUT_TOKENS_PER_CHAR=0.25
COST_RATE_INPUT_PER_1K_TOKENS_USD=0.0005
COST_RATE_OUTPUT_PER_1K_TOKENS_USD=0.0015
RESPONSE_CACHE_TTL_SECONDS=180
RESPONSE_CACHE_MAX_ENTRIES=500
DATA_RETENTION_DAYS=365

# --- Security ---
# Use a long random value in production (at least 32 chars)
SECRET_KEY=replace_with_a_long_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ADMIN_USERNAMES=admin

# --- Database ---
DATABASE_URL=sqlite:///./data/healthbuddy.db

# --- Custom Transformer ---
CUSTOM_MODEL_PATH=./data/checkpoints/transformer_best.pt
